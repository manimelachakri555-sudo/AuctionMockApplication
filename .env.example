# ==============================================================================
# SERVER-SIDE SECRETS & ENVIRONMENT VARIABLES (DO NOT EXPOSE TO FRONTEND)
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI squad rankings & scout analysis on the server.
# AI Studio automatically injects this at runtime from user secrets.
# Never hardcode this key or commit real keys to GitHub.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://your-app.run.app).
# AI Studio injects this at runtime with the Cloud Run service URL.
APP_URL="YOUR_APP_URL"

# PORT: Server HTTP port (defaults to 3000 in dev, 8080 in production containers)
PORT=3000

# ==============================================================================
# CLIENT-SIDE FIREBASE CONFIGURATION (VITE PUBLIC CONFIG)
# ==============================================================================
# Note: In Firebase web applications, client config values are public identifiers,
# NOT secret access tokens. Security MUST be enforced via Firebase Security Rules
# (firestore.rules), authorized domains, and Google Cloud Console API key restrictions.
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-iplmegaauctionli-7414f50a-2c58-4845-8773-6e282bdb3171"
